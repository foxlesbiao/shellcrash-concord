+        else
+            logger "$("$TMPDIR"/CrashCore -t -d "$BINDIR" -f "$TMPDIR"/config.yaml | grep -Eo 'error.*=.*')" 31
+        fi
         logger "自定义配置文件校验失败！将使用基础配置文件启动！" 33
         logger "错误详情请参考 "$TMPDIR"/error.yaml 文件！" 33
         mv -f "$TMPDIR"/config.yaml "$TMPDIR"/error.yaml >/dev/null 2>&1
