         v=$("$TMPDIR"/core_new version 2>/dev/null | grep version | awk '{print $3}')
         COMMAND='"$TMPDIR/CrashCore run -D $BINDIR -C $TMPDIR/jsons"'
     elif [ -z "$sbcheck" ] && "$TMPDIR"/core_new -h 2>&1 | grep -q '\-t';then
