     ##########需要变更的配置###########
     [ "$ipv6_dns" != "OFF" ] && dns_v6='true' || dns_v6='false'
     external="external-controller: 0.0.0.0:$db_port"
@@ -283,9 +287,20 @@ merger_yaml() {
 
 test_yaml() {
     #测试自定义配置文件
-    "$TMPDIR"/CrashCore -t -d "$BINDIR" -f "$TMPDIR"/config.yaml >/dev/null
-    if [ "$?" != 0 ]; then
-        logger "$("$TMPDIR"/CrashCore -t -d "$BINDIR" -f "$TMPDIR"/config.yaml | grep -Eo 'error.*=.*')" 31
+    # 直接看二进制是不是 concord，不依赖配置里的 $crashcore（可能还没改过来）
+    if "$TMPDIR"/CrashCore run -h 2>&1 | grep -qi 'concord'; then
+        "$TMPDIR"/CrashCore -t -c "$TMPDIR"/config.yaml >/dev/null
+        test_rc=$?
+    else
+        "$TMPDIR"/CrashCore -t -d "$BINDIR" -f "$TMPDIR"/config.yaml >/dev/null
