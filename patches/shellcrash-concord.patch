diff --git a/scripts/libs/core_tools.sh b/scripts/libs/core_tools.sh
index 684ca55..2188963 100644
--- a/scripts/libs/core_tools.sh
+++ b/scripts/libs/core_tools.sh
@@ -50,7 +50,14 @@ core_check(){
     core_unzip "$1" core_new
     sbcheck=$(echo "$crashcore" | grep 'singbox')
     v=''
-    if [ -n "$sbcheck" ] && "$TMPDIR"/core_new -h 2>&1 | grep -q 'sing-box'; then
+    # 按二进制的实际能力判定内核类型，不依赖配置里的 $crashcore——
+    # 配置可能与实际内核不符（例如首次安装的兜底值是 meta，而下载的却是 concord）。
+    if "$TMPDIR"/core_new run -h 2>&1 | grep -qi 'concord'; then
+        # Concord (Rust)：没有 -v，也没有 -t 的帮助输出，版本来自配置里的 concord_v。
+        # 数据目录必须独立，否则 concord 会往 $BINDIR 里写自己的 config.yaml。
+        v="${concord_v:-0.1.0}"
+        COMMAND='"$TMPDIR/CrashCore run -c $TMPDIR/config.yaml -d $CRASHDIR/concord"'
+    elif [ -n "$sbcheck" ] && "$TMPDIR"/core_new -h 2>&1 | grep -q 'sing-box'; then
         v=$("$TMPDIR"/core_new version 2>/dev/null | grep version | awk '{print $3}')
         COMMAND='"$TMPDIR/CrashCore run -D $BINDIR -C $TMPDIR/jsons"'
     elif [ -z "$sbcheck" ] && "$TMPDIR"/core_new -h 2>&1 | grep -q '\-t';then
