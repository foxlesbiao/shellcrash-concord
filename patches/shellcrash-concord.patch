-    if [ -n "$sbcheck" ] && "$TMPDIR"/core_new -h 2>&1 | grep -q 'sing-box'; then
+    # 按二进制的实际能力判定内核类型，不依赖配置里的 $crashcore——
+    # 配置可能与实际内核不符（例如首次安装的兜底值是 meta，而下载的却是 concord）。
+    if "$TMPDIR"/core_new run -h 2>&1 | grep -qi 'concord'; then
+        # Concord (Rust)：没有 -v，也没有 -t 的帮助输出，版本来自配置里的 concord_v。
