 prepare_clash_base_config() {
+    # Concord (Rust) 读取的就是 mihomo 配置格式，配置生成完全复用 meta 分支。
+    # 但内核检测（-t 参数）必须认它是 concord，所以把原始类型留在 core_kind。
+    [ -z "$core_kind" ] && core_kind="$crashcore"
